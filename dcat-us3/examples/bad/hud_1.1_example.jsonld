    {
      "@type": "dcat:Dataset",
      "title": "Community Challenge Grantees (ZIP)",
      "description": "This service provides location, and relevant data for Community Challenge Planning Grant recipients. The Department of Housing and Urban Development\u2019s Community Challenge Planning Grant Program fosters reform and reduces barriers to achieving affordable, economically vital, and sustainable communities. Such efforts may include amending or replacing local master plans, zoning codes, and building codes, either on a jurisdiction-wide basis or in a specific neighborhood, district, corridor, or sector to promote mixed-use development, affordable housing, the reuse of older buildings and structures for new purposes, and similar activities with the goal of promoting sustainability at the local or neighborhood level.",
      "modified": "2023-08-16T19:24:08.568Z",
