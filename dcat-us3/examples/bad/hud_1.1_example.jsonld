    {
      "@type": "dcat:Dataset",
      "title": "HUD Entitlement Grantee Jurisdiction - National Geospatial Data Asset (NGDA)",
      "description": "Established in 1974, the Community Development Block Grant (CDBG) Program provides annual grant funding to local and state governments to address a wide range of unique community development needs.\n\nHUD determines the amount of each grant by using a formula comprised of several measures of community need, including the extent of poverty, population, housing density, age of housing, and population growth relative to other metropolitan areas.\n\nThe annual CDBG appropriation is allocated among states and local jurisdictions categorized as \"entitlement\" and \"non-entitlement\" communities respectively. Entitlement communities are comprised of the principal cities of Metropolitan Statistical Areas (MSAs); metropolitan cities with populations of at least 50,000; and qualified urban counties with a population of 200,000 or more (excluding the populations of entitlement cities). Non-entitlement communities receive CDBG funding from their respective states in accordance with requirements that state.",
      "modified": "2019-05-18",
      "accessLevel": "public",
      "identifier": "HUD093",
      "publisher": {
        "@type": "org:Organization",
        "name": "U.S. Department of Housing and Urban Development"
      },
      "contactPoint": {
        "@type": "vcard:Contact",
        "fn": "HUD eGIS Help Desk",
        "hasEmail": "mailto:GIShelpdesk@hud.gov"
      },
      "distribution": [
        {
          "@type": "dcat:Distribution",
          "mediaType": "application/octet-stream",
          "downloadURL": "http://docs.huduser.gov/gis/FGDB/HudGrantees.gdb.zipx"
        },
        {
          "@type": "dcat:Distribution",
          "format": "API",
          "title": "Community Development Block Grant Grantee Areas"
        }
      ],
