    {
      "@type": "dcat:Dataset",
      "title": "Local Employment Dynamics (LED) for CDBG Grantee Areas",
      "description": "This dataset denotes Local Employment Dynamics (LED) data relative to Grantee areas for the Community Development Block Grant (CDBG) Program. The LED Partnership is a voluntary federal-state enterprise created for the purpose of merging employee, and employer data to provide a set of enhanced labor market statistics known collectively as Quarterly Workforce Indicators (QWI). The QWI are a set of economic indicators including employment, job creation, earnings, and other measures of employment flows.",
      "modified": "2023-07-31T13:56:00.428Z",
      "accessLevel": "public",
