    {
      "@type": "dcat:Dataset",
      "title": "Community Development Block Grant (CDBG) Disaster Recovery Buyouts",
      "description": "The data demonstrates the location of CDBG-DR-funded buyout activities as part of the Office of Community Planning and Development's (CPD) Disaster Recovery Buyout Program. The data is derived from an extract of HUD CPD\u2019s Disaster Recovery Grants Reporting (DRGR) System, an address-level dataset that includes Community Development Block Grant \u2013 Disaster Recovery activities for certain grantees and over a limited span of time during which grantees were required to report addresses of certain funded activities. Buyouts are a unique disaster-related activity made eligible through a waiver in the allocation of CDBG-DR grants following a natural hazard disaster. Under the waiver, grantees are permitted to use CDBG-DR funds to pay the pre-disaster or post-disaster value to acquire properties impacted by a natural hazard, usually flooding, for the purpose of risk reduction.",
      "modified": "2023-09-05T20:48:01.371Z",
      "accessLevel": "public",
      "identifier": "8ddd548cfc01462c9203e89ae974ba53",
      "publisher": {
        "@type": "org:Organization",
        "name": "U.S. Department of Housing and Urban Development"
      },
      "contactPoint": {
        "@type": "vcard:Contact",
        "fn": "HUD eGIS Help Desk",
        "hasEmail": "mailto:GIShelpdesk@hud.gov"
      },
      "distribution": [
        {
          "@type": "dcat:Distribution",
          "mediaType": "GeoDatabase/ZIP",
          "format": "ZIP",
