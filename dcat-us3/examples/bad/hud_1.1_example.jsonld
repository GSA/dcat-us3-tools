    {
      "@type": "dcat:Dataset",
      "title": "Public Housing Physical Inspection Scores",
      "description": "HUD's Real Estate Assessment Center conducts physical property inspections of properties that are owned, insured or subsidized by HUD, including public housing and multifamily assisted housing. About 20,000 such inspections are conducted each year to ensure that assisted families have housing that is decent, safe, sanitary and in good repair. This page provides a full historical view of the results of those inspections, providing point-in-time property scores. Results are available for download as a comma-delimited dataset. Separate datasets are available for public housing and for multifamily assisted properties. The results represent the inspections conducted from 2001 through January 2015. The dataset includes property identifiers and location information. \n\nDetailed descriptions of the inspection processes can be found in Federal Register notices 66 FR 59084 for public housing and 65 FR77230 for Office of Housing programs. \n\nMaking these inspection details available will enable researchers, advocacy groups and the general public to \n 1) better understand the physical condition of the HUD-assisted housing stock, as well as changes in the stock over time;\n 2) hold providers accountable for housing quality; and \n3) plan for future affordable housing needs.",
      "modified": "2019-04-11",
      "accessLevel": "public",
      "identifier": "HUD002",
      "publisher": {
        "@type": "org:Organization",
        "name": "U.S. Department of Housing and Urban Development"
      },
      "contactPoint": {
        "@type": "vcard:Contact",
        "fn": "HUDUser Help Desk",
        "hasEmail": "mailto:helpdesk@huduser.gov"
      },
      "distribution": [
        {
          "@type": "dcat:Distribution",
          "format": "xlsx",
          "title": "Public Housing Physical Inspection Scores",
          "accessURL": "https://www.huduser.gov/portal/datasets/pis.html",
          "describedBy": "http://www.huduser.gov/portal/datasets/pis/Data_Dictionary_Pub_Hsg_Property.doc",
          "describedByType": "text/doc"
        }
      ],
      "keyword": [
        "HUD",
