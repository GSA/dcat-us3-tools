    {
      "@type": "dcat:Dataset",
      "title": "HOME Participating Jurisdictions Open Activities Reports",
      "description": "This report is an MS Excel spreadsheet broken up by state. Participating Jurisdictions can use this report to view open activities in IDIS including activities with 100 percent of the funds drawn and with a status code of FD, or final draw. The HOME final rule at 24 CFR 92.502(d)(1) requires Participating Jurisdictions to enter project completion data into IDIS within 120 days of making a final draw for a project (see HOMEfires Vol. 6 No. 1, August 2005). In addition, Participating Jurisdictions can view activities that have been open (OP) for several years with little or no HOME funds drawn. These projects, if not progressing, should be cancelled. Likewise, Field Offices can use this report as a desk-monitoring tool to view each Participating Jurisdiction\u0092s open activities in need of completion or cancellation in IDIS.",
      "modified": "2020-07-31",
      "accessLevel": "public",
      "identifier": "HUD070",
      "publisher": {
        "@type": "org:Organization",
        "name": "U.S. Department of Housing and Urban Development"
      },
      "contactPoint": {
        "@type": "vcard:Contact",
        "fn": "Peter Huber",
        "hasEmail": "mailto:Peter.H.Huber@hud.gov"
      },
      "distribution": [
        {
          "@type": "dcat:Distribution",
          "mediaType": "text/html",
          "downloadURL": "https://www.hudexchange.info/programs/home/home-pjs-open-activities-reports/"
        }
      ],
      "keyword": [
        "HOME Investment Partnerships",
        "activities",
        "community development",
        "fund draws",
        "housing",
        "housing assistance",
        "open activities"
      ],
