    {
      "@type": "dcat:Dataset",
      "title": "HOME Activity by Tract",
      "description": "This service provides aggregated Home Investments Partnership Program (HOME) activity data by 2010 US Census Tracts. The HOME Program is a federal block grant program distributed (via formula) to states and local governments. Participating jurisdictions may use HOME funds for a variety of housing activities, according to local housing needs. Eligible uses of funds include: tenant-based rental assistance, housing rehabilitation, assistance to home-buyers, and new construction of housing.",
      "modified": "2023-06-06T22:14:40.211Z",
      "accessLevel": "public",
      "identifier": "2ef6e2c0244e456bb9031def11d61386",
      "publisher": {
        "@type": "org:Organization",
        "name": "U.S. Department of Housing and Urban Development"
      },
