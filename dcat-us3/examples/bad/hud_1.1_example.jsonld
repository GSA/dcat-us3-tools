        "025:06"
      ],
      "programCode": [
        "025:007"
      ],
      "landingPage": "https://www.hudexchange.info/programs/home/home-pjs-open-activities-reports/",
      "spatial": "USA"
    },
    {
      "@type": "dcat:Dataset",
      "title": "HOME Participating Jurisdictions Vacant Units Reports",
      "description": "This report is an MS Excel spreadsheet broken up by state, similar to the HOME Participating Jurisdiction's Open Activities Reports. The purpose of the HOME Participating Jurisdictions Vacant Units Reports is to help HOME Participating Jurisdictions identify units in HOME projects that are marked \u0093vacant\u0094 in the Integrated Disbursement and Information System (IDIS). If the vacant units are part of a completed HOME IDIS activity, occupancy and beneficiary data should be entered for these units.",
      "modified": "2020-07-31",
      "accessLevel": "public",
      "identifier": "HUD071",
      "publisher": {
        "@type": "org:Organization",
        "name": "U.S. Department of Housing and Urban Development"
