    {
      "@type": "dcat:Dataset",
      "title": "Low-Income Housing Tax Credit (LIHTC) Qualified Census Tract (QCT)",
      "description": "The Low-Income Housing Tax Credit (LIHTC) is the most important resource for creating affordable housing in the United States today. The LIHTC database, created by HUD and available to the public since 1997, contains information on 48,672 projects and 3.23 million housing units placed in service since 1987.\n\nLow-Income Housing Tax Credit Qualified Census Tracts must have 50 percent of households with incomes below 60 percent of the Area Median Gross Income (AMGI) or have a poverty rate of 25 percent or more. Difficult Development Areas (DDA) are areas with high land, construction and utility costs relative to the area median income and are based on Fair Market Rents, income limits, the 2010 census counts, and 5-year American Community Survey (ACS) data.",
      "modified": "2020-06-15",
      "accessLevel": "public",
      "identifier": "HUD004",
      "publisher": {
        "@type": "org:Organization",
        "name": "U.S. Department of Housing and Urban Development"
      },
      "contactPoint": {
        "@type": "vcard:Contact",
        "fn": "Michae Hollar",
        "hasEmail": "mailto:Michael.K.Hollar@HUD.gov"
      },
      "distribution": [
        {
          "@type": "dcat:Distribution",
          "title": "Qualified Census Tracts",
          "accessURL": "https://www.huduser.gov/portal/datasets/qct.html"
        },
        {
          "@type": "dcat:Distribution",
          "title": "Low-Income Housing Tax Credit"
        }
      ],
      "keyword": [
        "difficult development areas",
        "lihtc",
        "low-income housing tax credit",
        "qct",
        "qualified census tracts"
      ],
