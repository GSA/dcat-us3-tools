    {
      "@type": "dcat:Dataset",
      "title": "HUD GIS Boundary Files",
      "description": "The HUD GIS Boundary Files are intended to supplement boundary files available from the U.S. Census Bureau. The files are for community planners interested in working with census tract and block group data that splits by jurisdiction boundaries (summary levels 080, 090, and 091). The GIS shape files are most helpful when linked with census tract and block group data downloaded from the census standard tabulation data, CDBG low/mod area data (summary level 090), or the CHAS 2000 data (summary levels 080 and 091).",
      "modified": "2004-07-01",
      "accessLevel": "public",
      "identifier": "HUD035",
      "publisher": {
        "@type": "org:Organization",
        "name": "U.S. Department of Housing and Urban Development"
      },
      "contactPoint": {
        "@type": "vcard:Contact",
        "fn": "HUD eGIS Help Desk",
        "hasEmail": "mailto:GIShelpdesk@hud.gov"
      },
      "distribution": [
        {
          "@type": "dcat:Distribution",
          "title": "Census Special Tabulation Geographies",
          "description": "The files are in the ArcView Shapefile (.shp) format. Community planners may download the files at the state or county level. All of the files are zipped. When unzipped, there are 4 files that comprise the shapefile (.shx, .shp, .prj, and .dbf).",
          "accessURL": "https://www.huduser.gov/portal/datasets/geo/summarylevel.html"
        },
        {
          "@type": "dcat:Distribution",
          "title": "GIS Formula Boundary Files",
          "description": "While the Census Bureau provides GIS boundary files for many geographic components, the CPD formula grantee boundaries require special geography for which the boundary files are not available through the Census Bureau. HUD has developed two different sets of boundary files to supplement the Census Bureau boundary files:\n\n   CPD formula grantee jurisdiction boundaries \n   Split Census Tract and split Block Group boundaries"
        }
      ],
      "keyword": [
        "HUD",
        "block group data",
        "boundary file",
        "census",
        "census tract",
        "gis boundaries"
      ],
