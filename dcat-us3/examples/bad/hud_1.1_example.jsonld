    {
      "@type": "dcat:Dataset",
      "title": "HOME Grantee Areas",
      "description": "The HOME Investment Partnership Program (HOME) is authorized under Title II of the Cranston-Gonzalez National Affordable Housing Act. HOME provides formula grants to States and localities that communities use \u0096 often in partnership with local nonprofit groups \u0096 to fund a wide range of activities that build, buy, and/or rehabilitate affordable housing for rent or homeownership or provide direct rental assistance to low-income people. HOME is the largest Federal block grant to State and local governments designed exclusively to create affordable housing for low-income households. Each year it allocates approximately $2 billion among the States and hundreds of localities nationwide.",
      "modified": "2019-05-13",
      "accessLevel": "public",
      "identifier": "HUD108",
      "publisher": {
        "@type": "org:Organization",
        "name": "U.S. Department of Housing and Urban Development"
      },
      "contactPoint": {
